/* Fixed shirees/website_smoke_readonly_v1 entry. Credentials and schedule remain job-specific.
 * Shared protocol: scripts/run_smoke_ci.py; Jenkins adapter: ci/smoke_pipeline.groovy.
 */
def smokeCi
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '25', artifactNumToKeepStr: '25'))
    }

    parameters {
        choice(
            name: 'SMOKE_VIEWPORT',
            choices: ['both', 'desktop', 'mobile'],
            description: 'Run one Website Smoke Readonly V1 target. Default target is both.'
        )
    }

    environment {
        CI_SITE = 'shirees'
        CI_SUITE = 'website_smoke_readonly_v1'
        SHIREES_US_SHOPIFY_SIGNATURE = credentials('SHIREES_US_SHOPIFY_SIGNATURE')
        SHIREES_US_SHOPIFY_SIGNATURE_INPUT = credentials('SHIREES_US_SHOPIFY_SIGNATURE_INPUT')
        SHIREES_US_SHOPIFY_SIGNATURE_AGENT = credentials('SHIREES_US_SHOPIFY_SIGNATURE_AGENT')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    env.CI_RUN_ID = "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                    def scmVars = checkout scm
                    smokeCi = load 'ci/smoke_pipeline.groovy'
                    smokeCi.checkoutIdentity(scmVars)
                    smokeCi.initialize()
                }
            }
        }
        stage('Environment') {
            steps { script { smokeCi.environmentSetup() } }
        }
        stage('Install Dependencies') {
            steps { script { smokeCi.installDependencies() } }
        }
        stage('Prepare Run') {
            steps { script { smokeCi.runStep('prepare') } }
        }
        stage('Install Playwright Browsers') {
            steps { script { smokeCi.installBrowsers() } }
        }
        stage('Static Validation') {
            steps { script { smokeCi.runStep('static') } }
        }
        stage('Runtime Contract') {
            steps { script { smokeCi.runStep('runtime') } }
        }
        stage('Signed Request / Site Access') {
            steps { script { smokeCi.runStep('access') } }
        }
        stage('Website Smoke Readonly V1') {
            steps { script { smokeCi.runStep('smoke') } }
        }
        stage('Secret Leakage Check') {
            steps { script { smokeCi.runStep('secret') } }
        }
        stage('Result Validation') {
            steps { script { smokeCi.runStep('schema') } }
        }
    }

    post {
        always {
            script {
                if (smokeCi != null) { smokeCi.publish() }
                else {
                    // Checkout/load/credential failure: no dependency on Python.
                    currentBuild.result = 'FAILURE'
                    env.CI_RUN_ID = env.CI_RUN_ID ?: "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                    dir("artifacts/ci/${env.CI_RUN_ID}") {
                        writeFile file: 'publication-failure.json', text: '{"status":"FAIL","classification":"CURRENT_RESULTS_MISSING"}\n'
                    }
                    dir("artifacts/ci/${env.CI_RUN_ID}") {
                        writeFile file: 'summary.html', text: '<!doctype html><html lang="en"><meta charset="utf-8"><title>Current build bootstrap failure</title><h1>Infrastructure failure: CURRENT_RESULTS_MISSING</h1><p>Phase: checkout / helper load / initialization. Business result: NOT_AVAILABLE. Run identity and gates: NOT_VALIDATED. See the surrounding Jenkins build for commit, job and build identity. No current results, evidence or history acknowledgement are available; historical output is never substituted.</p></html>'
                    }
                    archiveArtifacts artifacts: "artifacts/ci/${env.CI_RUN_ID}/publication-failure.json", allowEmptyArchive: false, fingerprint: false
                    archiveArtifacts artifacts: "artifacts/ci/${env.CI_RUN_ID}/summary.html", allowEmptyArchive: false, fingerprint: false
                }
            }
        }
    }
}
