/*
 * Jenkins orchestration for the fixed Shirees Website Smoke V1 contract.
 *
 * This definition is intentionally manual-only. The Python runner owns
 * business behavior, transactional mutation policy, exit codes, results.json
 * and evidence.
 */
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '25', artifactNumToKeepStr: '25'))
    }

    parameters {
        choice(
            name: 'SMOKE_VIEWPORT',
            choices: ['both', 'desktop', 'mobile'],
            description: 'Run the Shirees Website Smoke V1 target. Default target is both.'
        )
    }

    environment {
        // These IDs are Jenkins credential IDs, never credential values.
        SHIREES_US_SHOPIFY_SIGNATURE = credentials('SHIREES_US_SHOPIFY_SIGNATURE')
        SHIREES_US_SHOPIFY_SIGNATURE_INPUT = credentials('SHIREES_US_SHOPIFY_SIGNATURE_INPUT')
        SHIREES_US_SHOPIFY_SIGNATURE_AGENT = credentials('SHIREES_US_SHOPIFY_SIGNATURE_AGENT')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    env.STABILITY_SECRET_GATE = 'NOT_RUN'
                    env.STABILITY_SCHEMA_GATE = 'NOT_RUN'
                    env.STABILITY_PYTHON_EXIT_CODE = 'UNKNOWN'

                    env.CI_RUN_ID = "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                    env.CI_CONTEXT_PATH = "artifacts/ci/${env.CI_RUN_ID}/run_context.json"
                    env.CI_RESULT_PATH = "artifacts/website-smoke-v1/shirees/${env.CI_RUN_ID}/results.json"
                    env.CI_PYTHON_EXIT_CODE = 'UNKNOWN'
                    env.CI_SECRET_GATE = 'NOT_RUN'
                    env.CI_SCHEMA_GATE = 'NOT_RUN'

                    def scmVars = checkout scm
                    def checkoutSha = "${scmVars?.GIT_COMMIT ?: ''}".trim()
                    if (!checkoutSha) {
                        if (isUnix()) {
                            checkoutSha = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                        } else {
                            checkoutSha = bat(returnStdout: true, script: '@git rev-parse HEAD').trim()
                        }
                    }
                    if (!checkoutSha) {
                        error('Unable to determine the checked-out workspace HEAD SHA')
                    }
                    env.GIT_COMMIT_SHA = checkoutSha
                    echo "Checkout SHA: ${checkoutSha}"
                }
            }
        }

        stage('Environment') {
            steps {
                script {
                    echo 'Site: shirees'
                    echo 'Signed Request: configured by Jenkins Credentials Binding (values redacted)'
                    echo env.SHOPIFY_PROXY_SERVER?.trim() ?
                        'Proxy: configured through the Jenkins environment (server value redacted)' :
                        'Proxy: direct mode; SHOPIFY_PROXY_SERVER is not configured'
                    if (isUnix()) {
                        env.SYSTEM_PYTHON = sh(
                            returnStdout: true,
                            script: '''
                                if command -v python3 >/dev/null 2>&1; then
                                    command -v python3
                                elif command -v python >/dev/null 2>&1; then
                                    command -v python
                                else
                                    echo "No Python interpreter found on this Jenkins Agent" >&2
                                    exit 127
                                fi
                            '''
                        ).trim()
                        env.PYTHON_BIN = '.venv/bin/python'
                        sh "${env.SYSTEM_PYTHON} --version"
                    } else {
                        env.SYSTEM_PYTHON = 'python'
                        env.PYTHON_BIN = '.venv\\Scripts\\python.exe'
                        bat 'where python'
                        bat 'python --version'
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                script {
                    if (isUnix()) {
                        sh "${env.SYSTEM_PYTHON} -m venv .venv"
                        sh '.venv/bin/python -m pip install --no-input -r requirements.lock.txt'
                    } else {
                        bat 'python -m venv .venv'
                        bat '.venv\\Scripts\\python.exe -m pip install --no-input -r requirements.lock.txt'
                    }
                }
            }
        }

        stage('Prepare Run') {
            steps {
                script {
                    if (isUnix()) {
                        sh ".venv/bin/python scripts/prepare_run_context.py --site shirees --suite website_smoke_v1 --viewport ${params.SMOKE_VIEWPORT}"
                    } else {
                        bat ".venv\\Scripts\\python.exe scripts\\prepare_run_context.py --site shirees --suite website_smoke_v1 --viewport ${params.SMOKE_VIEWPORT}"
                    }
                }
            }
        }

        stage('Install Playwright Browsers') {
            steps {
                script {
                    if (isUnix()) {
                        sh '.venv/bin/python -m playwright install chromium webkit'
                    } else {
                        bat '.venv\\Scripts\\python.exe -m playwright install chromium webkit'
                    }
                }
            }
        }

        stage('Static Validation') {
            steps {
                script {
                    if (isUnix()) {
                        sh '.venv/bin/python -m compileall .'
                        sh '.venv/bin/python scripts/validate_site_config.py --site shirees --suite website_smoke_v1'
                    } else {
                        bat '.venv\\Scripts\\python.exe -m compileall .'
                        bat '.venv\\Scripts\\python.exe scripts\\validate_site_config.py --site shirees --suite website_smoke_v1'
                    }
                }
            }
        }

        stage('Runtime Contract') {
            steps {
                script {
                    if (isUnix()) {
                        sh '.venv/bin/python scripts/validate_runtime_contract.py'
                    } else {
                        bat '.venv\\Scripts\\python.exe scripts\\validate_runtime_contract.py'
                    }
                }
            }
        }

        stage('Signed Request / Site Access') {
            steps {
                script {
                    if (isUnix()) {
                        sh '.venv/bin/python scripts/validate_site_access.py --site shirees --viewport both'
                    } else {
                        bat '.venv\\Scripts\\python.exe scripts\\validate_site_access.py --site shirees --viewport both'
                    }
                }
            }
        }

        stage('Website Smoke V1') {
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        int smokeExitCode
                        if (isUnix()) {
                            smokeExitCode = sh(
                                returnStatus: true,
                                script: ".venv/bin/python scripts/run_website_smoke_v1.py --site shirees --viewport ${params.SMOKE_VIEWPORT} --run-id ${env.CI_RUN_ID} --run-context ${env.CI_CONTEXT_PATH} --traffic-inventory"
                            )
                        } else {
                            smokeExitCode = bat(
                                returnStatus: true,
                                script: ".venv\\Scripts\\python.exe scripts\\run_website_smoke_v1.py --site shirees --viewport ${params.SMOKE_VIEWPORT} --run-id ${env.CI_RUN_ID} --run-context ${env.CI_CONTEXT_PATH} --traffic-inventory"
                            )
                        }
                        env.STABILITY_PYTHON_EXIT_CODE = "${smokeExitCode}"
                        env.CI_PYTHON_EXIT_CODE = "${smokeExitCode}"
                        if (smokeExitCode != 0) {
                            error("Shirees Website Smoke V1 exited with code ${smokeExitCode}")
                        }
                    }
                }
            }
        }

        stage('Secret Leakage Check') {
            steps {
                script {
                    int gateExitCode
                    if (isUnix()) {
                        gateExitCode = sh(returnStatus: true, script: ".venv/bin/python scripts/validate_ci_safe_outputs.py --run-context ${env.CI_CONTEXT_PATH}")
                    } else {
                        gateExitCode = bat(returnStatus: true, script: ".venv\\Scripts\\python.exe scripts\\validate_ci_safe_outputs.py --run-context ${env.CI_CONTEXT_PATH}")
                    }
                    env.STABILITY_SECRET_GATE = gateExitCode == 0 ? 'PASS' : 'FAIL'
                    env.CI_SECRET_GATE = gateExitCode == 0 ? 'PASS' : 'FAIL'
                    if (gateExitCode != 0) {
                        error("Secret Leakage Check exited with code ${gateExitCode}")
                    }
                }
            }
        }

        stage('Result Validation') {
            steps {
                script {
                    int gateExitCode
                    if (isUnix()) {
                        gateExitCode = sh(returnStatus: true, script: ".venv/bin/python scripts/validate_result_schema.py --suite website_smoke_v1 --run-context ${env.CI_CONTEXT_PATH} --results ${env.CI_RESULT_PATH}")
                    } else {
                        gateExitCode = bat(returnStatus: true, script: ".venv\\Scripts\\python.exe scripts\\validate_result_schema.py --suite website_smoke_v1 --run-context ${env.CI_CONTEXT_PATH} --results ${env.CI_RESULT_PATH}")
                    }
                    env.STABILITY_SCHEMA_GATE = gateExitCode == 0 ? 'PASS' : 'FAIL'
                    env.CI_SCHEMA_GATE = gateExitCode == 0 ? 'PASS' : 'FAIL'
                    if (gateExitCode != 0) {
                        error("Result Validation exited with code ${gateExitCode}")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (!env.CI_RUN_ID) {
                    env.CI_RUN_ID = "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                }
                try {
                    def causes = "${currentBuild.getBuildCauses()}"
                    env.CI_TRIGGER = causes.contains('TimerTriggerCause') ? 'TIMER' :
                        causes.contains('SCMTriggerCause') ? 'SCM' :
                        causes.contains('UserIdCause') ? 'MANUAL' : 'OTHER'
                } catch (ignored) {
                    env.CI_TRIGGER = 'UNKNOWN'
                }
                try {
                    def contextPath = env.CI_CONTEXT_PATH ?: "artifacts/ci/${env.CI_RUN_ID}/run_context.json"
                    def exitCode = env.CI_PYTHON_EXIT_CODE ?: 'UNKNOWN'
                    def buildResult = currentBuild.currentResult ?: 'FAILURE'
                    int publishExit
                    if (isUnix()) {
                        publishExit = sh(returnStatus: true, script: ".venv/bin/python scripts/finalize_ci_run.py --run-context ${contextPath} --python-exit-code ${exitCode} --jenkins-result ${buildResult}")
                    } else {
                        publishExit = bat(returnStatus: true, script: ".venv\\Scripts\\python.exe scripts\\finalize_ci_run.py --run-context ${contextPath} --python-exit-code ${exitCode} --jenkins-result ${buildResult}")
                    }
                    if (publishExit != 0) {
                        error('Current invocation failed validation or publication scan')
                    }
                    // The finalizer has frozen and scanned every candidate file.
                    archiveArtifacts artifacts: "artifacts/ci/${env.CI_RUN_ID}/publish/**", allowEmptyArchive: false, fingerprint: false
                    int acknowledgeExit
                    if (isUnix()) {
                        acknowledgeExit = sh(returnStatus: true, script: ".venv/bin/python scripts/finalize_ci_run.py --run-context ${contextPath} --acknowledge")
                    } else {
                        acknowledgeExit = bat(returnStatus: true, script: ".venv\\Scripts\\python.exe scripts\\finalize_ci_run.py --run-context ${contextPath} --acknowledge")
                    }
                    if (acknowledgeExit != 0) {
                        error('Current invocation archive acknowledgement failed')
                    }
                } catch (ignored) {
                    currentBuild.result = 'FAILURE'
                    // Available even when dependencies/site access failed. No raw output.
                    def failureCode = !env.CI_RESULT_PATH || !fileExists(env.CI_RESULT_PATH) ?
                        'CURRENT_RESULTS_MISSING' : env.CI_SECRET_GATE != 'PASS' ?
                        'CURRENT_SECRET_SCAN_NOT_PASSED' : env.CI_SCHEMA_GATE != 'PASS' ?
                        'CURRENT_SCHEMA_NOT_PASSED' : 'CURRENT_RUN_PUBLICATION_FAILED'
                    def failurePath = "artifacts/ci/${env.CI_RUN_ID}/publication-failure.json"
                    dir("artifacts/ci/${env.CI_RUN_ID}") {
                        writeFile file: 'publication-failure.json', text: '{"status":"FAIL","classification":"' + failureCode + '"}\n'
                    }
                    archiveArtifacts artifacts: failurePath, allowEmptyArchive: false, fingerprint: false
                }
            }
        }
    }
}
