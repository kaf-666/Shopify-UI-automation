/* Fixed lavetir/website_smoke_readonly_v1 entry. Credentials and schedule remain job-specific.
 * Shared protocol: scripts/run_smoke_ci.py; Jenkins adapter: ci/smoke_pipeline.groovy.
 */
def smokeCi
pipeline {
    agent any

    triggers { cron('H H/4 * * *') }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '25', artifactNumToKeepStr: '25'))
    }

    parameters {
        choice(
            name: 'SMOKE_VIEWPORT',
            choices: ['both', 'desktop', 'mobile'],
            description: 'Run the Lavetir Website Smoke Readonly V1 target. Default target is both.'
        )
        booleanParam(
            name: 'VARIANT_DIAGNOSTIC',
            defaultValue: false,
            description: 'Run the readonly post-selection variant stability diagnostic before formal smoke.'
        )
    }

    environment {
        CI_SITE = 'lavetir'
        CI_SUITE = 'website_smoke_readonly_v1'
        LAVETIR_US_SHOPIFY_SIGNATURE = credentials('LAVETIR_US_SHOPIFY_SIGNATURE')
        LAVETIR_US_SHOPIFY_SIGNATURE_INPUT = credentials('LAVETIR_US_SHOPIFY_SIGNATURE_INPUT')
        LAVETIR_US_SHOPIFY_SIGNATURE_AGENT = credentials('LAVETIR_US_SHOPIFY_SIGNATURE_AGENT')
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    env.CI_RUN_ID = "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                    def scmVars = checkout scm
                    smokeCi = load 'ci/smoke_pipeline.groovy'
                    smokeCi.checkoutIdentity(scmVars)
                    smokeCi.initialize()
                }
            }
        }
        stage('Environment') {
            steps { script { smokeCi.environmentSetup() } }
        }
        stage('Install Dependencies') {
            steps { script { smokeCi.installDependencies() } }
        }
        stage('Prepare Run') {
            steps { script { smokeCi.runStep('prepare') } }
        }
        stage('Install Playwright Browsers') {
            steps { script { smokeCi.installBrowsers() } }
        }
        stage('Static Validation') {
            steps { script { smokeCi.runStep('static') } }
        }
        stage('Runtime Contract') {
            steps { script { smokeCi.runStep('runtime') } }
        }
        stage('Site Access') {
            steps { script { smokeCi.runStep('access') } }
        }
        stage('Variant Stability Diagnostic') {
            when { expression { params.VARIANT_DIAGNOSTIC == true } }
            steps {
                script {
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        smokeCi.runStep('variant-diagnostic')
                    }
                }
            }
        }
        stage('Website Smoke Readonly V1') {
            steps { script { smokeCi.runStep('smoke') } }
        }
        stage('Secret Leakage Check') {
            steps { script { smokeCi.runStep('secret') } }
        }
        stage('Result Validation') {
            steps { script { smokeCi.runStep('schema') } }
        }
    }

    post {
        always {
            script {
                if (smokeCi != null) { smokeCi.publish() }
                else {
                    // Checkout/load/credential failure: no dependency on Python.
                    currentBuild.result = 'FAILURE'
                    env.CI_RUN_ID = env.CI_RUN_ID ?: "build-${env.BUILD_NUMBER}-${currentBuild.startTimeInMillis}"
                    dir("artifacts/ci/${env.CI_RUN_ID}") {
                        writeFile file: 'publication-failure.json', text: '{"status":"FAIL","classification":"CURRENT_RESULTS_MISSING"}\n'
                    }
                    archiveArtifacts artifacts: "artifacts/ci/${env.CI_RUN_ID}/publication-failure.json", allowEmptyArchive: false, fingerprint: false
                }
            }
        }
    }
}
